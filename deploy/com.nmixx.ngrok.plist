<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nmixx.ngrok</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>exec ngrok http --url=__NGROK_DOMAIN__ 8080 --log=stdout</string>
    </array>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/nmixx-ngrok.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/nmixx-ngrok.log</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
