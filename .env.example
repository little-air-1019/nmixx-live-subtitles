# Copy to .env and fill in. .env is gitignored.
DISCORD_WEBHOOK_URL=
SONIOX_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
# Stable public HTTPS base for the WebSub callback, e.g. https://your-name.ngrok-free.app
PUBLIC_BASE_URL=
WEBSUB_VERIFY_TOKEN=change-me
YOUTUBE_CHANNEL_ID=UCnUAyD4t2LkvW68YrDh7fDg
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
# Keep gemini until Soniox has been tested; change to soniox and restart to switch.
SUBTITLE_PROVIDER=gemini
SONIOX_MODEL=stt-rt-v5
# false: Korean -> Chinese in Soniox; English unchanged; other languages -> Gemini text API.
# Requires GEMINI_API_KEY for fallback. Spoken Chinese is normalized locally with OpenCC.
# true: Soniox native translation for all supported source languages -> Chinese.
SONIOX_TRANSLATE_ENGLISH=false
TEXT_TRANSLATION_MODEL=gemini-3.5-flash-lite
# Local audio/evidence capture for live YouTube and manual FANS sessions; no extra API.
QUALITY_CAPTURE_ENABLED=true
# Default: ~/Library/Application Support/nmixx-subtitles/sessions
# QUALITY_CAPTURE_DIR=/absolute/path/to/sessions
QUALITY_RETENTION_DAYS=7
# Storage budget in bytes (2 GiB); 0 disables the size limit. Approx. 115 MB audio/hour.
QUALITY_MAX_BYTES=2147483648
