# Copy to .env and fill in. .env is gitignored.
DISCORD_WEBHOOK_URL=
SONIOX_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
# Stable public HTTPS base for the WebSub callback, e.g. https://your-name.ngrok-free.app
PUBLIC_BASE_URL=
WEBSUB_VERIFY_TOKEN=change-me
YOUTUBE_CHANNEL_ID=UCnUAyD4t2LkvW68YrDh7fDg
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
# Keep gemini until Soniox has been tested; change to soniox and restart to switch.
SUBTITLE_PROVIDER=gemini
SONIOX_MODEL=stt-rt-v5
# false: Korean <-> Chinese, other languages (including English) stay as source text.
# true: all supported source languages -> Chinese.
SONIOX_TRANSLATE_ENGLISH=false
